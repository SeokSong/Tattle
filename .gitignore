# captures, databases and logs hold real traffic metadata: never commit them
*.pcap
*.pcapng
*.sqlite
*.sqlite-*
*.db
*.log

# local curation output (tattle companies coverage --unmatched-out) holds real domain names
*.unmatched-domains.txt

# an App Privacy Report export lists the apps and domains of a real phone: never commit one
*.ndjson
*.jsonl
App_Privacy_Report*

# audit references are licensed for reference only: never commit them (scripts/audit-references.sh)
cert-orgs.tsv
domain_map.json
ddg-provenance.txt
reference/
